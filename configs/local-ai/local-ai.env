# Local, single-user coding model. This file contains no secret values.
LOCAL_AI_MODEL_REPO=ubergarm/GLM-4.7-Flash-GGUF
LOCAL_AI_MODEL_FILE=GLM-4.7-Flash-MXFP4.gguf
LOCAL_AI_MODEL_NAME=glm-4.7-flash-local
LOCAL_AI_HOST=127.0.0.1
LOCAL_AI_PORT=8000
LOCAL_AI_CTX_SIZE=32768
LOCAL_AI_GPU_LAYERS=99
LOCAL_AI_CACHE_TYPE_K=q8_0
LOCAL_AI_CACHE_TYPE_V=q8_0
LOCAL_AI_PARALLEL=1
LOCAL_AI_MODEL_DIR="$HOME/.local/share/local-ai-coding/models"
LOCAL_AI_LLAMA_DIR="$HOME/.local/opt/llama.cpp"
LOCAL_AI_STATE_DIR="$HOME/.local/state/local-ai-coding"
LOCAL_AI_START_TIMEOUT_SECONDS=180
