# Copy to .env on weckerAA. This file intentionally contains no credentials.
# Keep the data directory backed up; it contains the Music Assistant database
# and provider configuration.
MA_DATA_DIR=/srv/music-assistant/data

# This path must already be mounted on the host. It is read-only in the
# container, so Music Assistant cannot change the music library.
MA_MUSIC_DIR=/srv/media/music

# Possible values: critical, error, warning, info, debug.
MA_LOG_LEVEL=info

# Alexa Developer Console skill ID for the private Music Assistant skill.
# This is an identifier, not a credential.
MA_ALEXA_SKILL_ID=amzn1.ask.skill.70d27904-5175-4ba0-b069-217cbf42ce2e
