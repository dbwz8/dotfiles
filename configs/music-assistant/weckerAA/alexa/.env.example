# Hostnames only: do not include https:// or a path.
# The Alexa Developer Console endpoint is https://${ALEXA_SKILL_HOSTNAME}.
ALEXA_SKILL_HOSTNAME=alexa.dbwz8.com

# This public HTTPS URL must route through Cloudflare to MA's stream server on
# port 8097. It is required for Echo speakers, which cannot use the APL-only
# path.
MA_STREAM_URL=https://stream.dbwz8.com

ALEXA_LOCALE=en-US
AWS_DEFAULT_REGION=us-east-1
TZ=America/Los_Angeles
