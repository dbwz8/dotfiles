      "Bash(fmt.printf)",
      "Bash(move1 *)",
      "Bash(newstate, *)",
      "Bash(return)",
      "Bash(})",
      "Bash(newhash *)",
      "Bash(newstate.board)",
      "Bash(move2 *)",
      "Bash(finalstate, *)",
      "Bash(finalhash *)",
      "Bash(finalstate.board)",
      "Bash(eof)",
      "Bash(data, *)",
      "Bash(git checkout *)",
      "Bash(grep *)",
      "Bash(cp *)",
      "Bash(python3)",
      "Bash(with)",
      "Bash(as *)",
