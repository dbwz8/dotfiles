{
  "modelProviders": {
    "openai": [
      {
        "id": "qwen3-coder-next-80b",
        "name": "weckerAA Qwen3-Coder-Next 80B",
        "baseUrl": "http://127.0.0.1:18023/v1",
        "description": "Qwen3-Coder-Next 80B served by llama.cpp through the local coding-agent endpoint on weckerAA.",
        "capabilities": {
          "agent": true
        },
        "envKey": "OPENAI_API_KEY",
        "generationConfig": {
          "contextWindowSize": 16384,
          "samplingParams": {
            "max_tokens": 4096,
            "temperature": 0.2,
            "top_p": 0.8
          }
        }
      }
    ]
  },
  "env": {
    "OPENAI_API_KEY": "local-vllm"
  },
  "generationConfig": {
    "contextWindowSize": 16384,
    "samplingParams": {
      "max_tokens": 4096,
      "temperature": 0.2,
      "top_p": 0.8
    }
  },
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "model": {
    "name": "qwen3-coder-next-80b",
    "baseUrl": "http://127.0.0.1:18023/v1",
    "generationConfig": {
      "contextWindowSize": 16384,
      "samplingParams": {
        "max_tokens": 4096,
        "temperature": 0.2,
        "top_p": 0.8
      }
    },
    "sessionTokenLimit": 12000,
    "skipStartupContext": true,
    "chatCompression": {
      "maxRecentFilesToRetain": 0,
      "maxRecentImagesToRetain": 4
    },
    "reasoningEffort": "low"
  },
  "context": {
    "autoCompactThreshold": 0.85
  },
  "tools": {
    "approvalMode": "auto-edit"
  },
  "memory": {
    "enableManagedAutoMemory": false,
    "enableAutoSkill": false
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "$version": 4,
  "ui": {
    "autoModeAcknowledged": true
  },
  "permissions": {
    "allow": [
      "Bash(time *)",
      "Read(//home/wecker/git/languages/rust/docs/**)",
      "Read(//home/wecker/git/languages/rust/**)",
      "Bash(cargo build)",
      "Bash(cargo test)",
      "Bash(cargo run *)",
      "Bash(sed *)",
      "Bash(xxd)",
      "Agent(Explore)",
      "Read(//home/wecker/**)",
      "Bash(cd *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(echo *)",
      "Bash(sort)",
      "Bash(cat *)",
      "Bash(git rev-parse *)",
      "Bash(grep *)"
    ]
  }
}
